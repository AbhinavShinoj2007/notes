#include <stdio.h>
#include <stdbool.h>

#define MAX_V 100 // Maximum capacity limit for the array dimensions
void BFS(int graph[MAX_V][MAX_V], int V, int startNode) {
    bool visited[MAX_V] = {false};
    int queue[MAX_V];int front = 0;int rear = 0;
    // Enqueue start node
    queue[rear] = startNode;
    rear++;
    visited[startNode] = true;
    printf("\nBFS Traversal starting from node %d: ", startNode);
    while (front < rear) {
        int currentNode = queue[front];
        front++;  
        printf("%d ", currentNode);
        for (int neighbor = 0; neighbor < V; neighbor++) {
            if (graph[currentNode][neighbor] == 1 && !visited[neighbor]) {
                queue[rear] = neighbor;
                rear++;
                visited[neighbor] = true;
            }}}
    printf("\n");
}
int main() {
    int V;int graph[MAX_V][MAX_V];int startNode;
    // 1. Get the size of the graph
    printf("Enter the number of vertices (Max %d): ", MAX_V);
    if (scanf("%d", &V) != 1 || V <= 0 || V > MAX_V) {
        printf("Invalid number of vertices.\n");
        return 1;
    }
    // 2. Get matrix values from user
    printf("\nEnter the Adjacency Matrix row by row (use 0 or 1):\n");
    for (int i = 0; i < V; i++) {
        printf("Row %d (%d integers separated by spaces): ", i, V);
        for (int j = 0; j < V; j++) {
            scanf("%d", &graph[i][j]);
        }
    }
    // 3. Choose starting point
    printf("\nEnter the starting node index (0 to %d): ", V - 1);
    scanf("%d", &startNode);

    if (startNode < 0 || startNode >= V) {
        printf("Invalid starting node.\n");
        return 1;
    }
    // Run BFS traversal
    BFS(graph, V, startNode);

    return 0;
}
